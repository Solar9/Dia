#!/usr/bin/env python3
"""Keep Dia's version the same in every place that carries it.

  scripts/bump-version 0.1.1     # write the new version everywhere
  scripts/bump-version --check   # exit 1 if any place differs from pyproject.toml

pyproject.toml is the source of truth for --check. PKGBUILD stays @VERSION@
and is filled when the public release is built.
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def pyproject_version() -> str:
    text = (ROOT / "pyproject.toml").read_text(encoding="utf-8")
    match = re.search(r'^version\s*=\s*"([^"]+)"', text, re.M)
    if not match:
        raise SystemExit("pyproject.toml: no version = \"…\"")
    return match.group(1)


def read_places() -> dict[str, str]:
    """Map label -> version found (or missing)."""
    found: dict[str, str] = {}
    found["pyproject.toml"] = pyproject_version()

    init = (ROOT / "src/dia/__init__.py").read_text(encoding="utf-8")
    m = re.search(r'^__version__\s*=\s*"([^"]+)"', init, re.M)
    found["src/dia/__init__.py"] = m.group(1) if m else ""

    meta = json.loads((ROOT / "src/dia/ui/plasmoid/metadata.json").read_text(encoding="utf-8"))
    found["src/dia/ui/plasmoid/metadata.json"] = meta["KPlugin"]["Version"]

    pkg = json.loads((ROOT / "mobile/package.json").read_text(encoding="utf-8"))
    found["mobile/package.json"] = pkg["version"]

    lock = (ROOT / "mobile/package-lock.json").read_text(encoding="utf-8")
    # Root package only (name dia-mobile appears twice: top and packages[""]).
    root_ver = re.search(
        r'"name": "dia-mobile",\s*"version": "([^"]+)"', lock
    )
    packages_ver = re.search(
        r'"packages": \{\s*"": \{\s*"name": "dia-mobile",\s*"version": "([^"]+)"',
        lock,
    )
    found["mobile/package-lock.json (root)"] = root_ver.group(1) if root_ver else ""
    found["mobile/package-lock.json (packages)"] = packages_ver.group(1) if packages_ver else ""

    gradle = (ROOT / "mobile/android/app/build.gradle").read_text(encoding="utf-8")
    g = re.search(r'versionName\s*=\s*System\.getenv\("DIA_VERSION_NAME"\)\s*\?: "([^"]+)"', gradle)
    found["mobile/android/app/build.gradle"] = g.group(1) if g else ""

    pbx = (ROOT / "mobile/ios/App/App.xcodeproj/project.pbxproj").read_text(encoding="utf-8")
    ios = re.findall(r"MARKETING_VERSION = ([^;]+);", pbx)
    found["mobile/ios MARKETING_VERSION (debug)"] = ios[0].strip() if len(ios) > 0 else ""
    found["mobile/ios MARKETING_VERSION (release)"] = ios[1].strip() if len(ios) > 1 else ""

    return found


def check() -> int:
    expected = pyproject_version()
    places_ = read_places()
    bad = [
        f"  {label}: {ver!r} (want {expected!r})"
        for label, ver in places_.items()
        if ver != expected
    ]
    if bad:
        print("Version drift — pyproject.toml is the source of truth:", file=sys.stderr)
        print("\n".join(bad), file=sys.stderr)
        print("Fix with: scripts/bump-version", expected, file=sys.stderr)
        return 1
    print(f"All {len(places_)} version places say {expected}.")
    return 0


def bump(version: str) -> None:
    if not re.fullmatch(r"\d+\.\d+\.\d+[a-z0-9.-]*", version):
        raise SystemExit(f"refusing version {version!r}: expected N.N.N…")

    def sub_file(path: Path, pattern: str, repl: str, flags: int = 0) -> None:
        text = path.read_text(encoding="utf-8")
        new, n = re.subn(pattern, repl, text, count=0, flags=flags)
        if n < 1:
            raise SystemExit(f"{path}: pattern did not match:\n  {pattern}")
        path.write_text(new, encoding="utf-8")

    sub_file(ROOT / "pyproject.toml", r'^version\s*=\s*"[^"]+"', f'version = "{version}"', re.M)
    sub_file(
        ROOT / "src/dia/__init__.py",
        r'^__version__\s*=\s*"[^"]+"',
        f'__version__ = "{version}"',
        re.M,
    )

    meta_path = ROOT / "src/dia/ui/plasmoid/metadata.json"
    meta = json.loads(meta_path.read_text(encoding="utf-8"))
    meta["KPlugin"]["Version"] = version
    meta_path.write_text(json.dumps(meta, indent=4) + "\n", encoding="utf-8")

    pkg_path = ROOT / "mobile/package.json"
    pkg = json.loads(pkg_path.read_text(encoding="utf-8"))
    pkg["version"] = version
    pkg_path.write_text(json.dumps(pkg, indent=2) + "\n", encoding="utf-8")

    lock_path = ROOT / "mobile/package-lock.json"
    lock = lock_path.read_text(encoding="utf-8")
    lock, n1 = re.subn(
        r'("name": "dia-mobile",\s*"version": ")[^"]+(")',
        rf"\g<1>{version}\2",
        lock,
        count=1,
    )
    lock, n2 = re.subn(
        r'("packages": \{\s*"": \{\s*"name": "dia-mobile",\s*"version": ")[^"]+(")',
        rf"\g<1>{version}\2",
        lock,
        count=1,
    )
    if n1 != 1 or n2 != 1:
        raise SystemExit(
            f"mobile/package-lock.json: expected 1+1 dia-mobile versions, got {n1}+{n2}"
        )
    lock_path.write_text(lock, encoding="utf-8")

    sub_file(
        ROOT / "mobile/android/app/build.gradle",
        r'(versionName = System\.getenv\("DIA_VERSION_NAME"\) \?: ")[^"]+(")',
        rf"\g<1>{version}\2",
    )
    sub_file(
        ROOT / "mobile/ios/App/App.xcodeproj/project.pbxproj",
        r"MARKETING_VERSION = [^;]+;",
        f"MARKETING_VERSION = {version};",
    )

    if check() != 0:
        raise SystemExit("bump wrote files but check still fails")
    print(f"Bumped to {version}.")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", nargs="?", help="new version, e.g. 0.1.1")
    parser.add_argument("--check", action="store_true", help="verify every place matches pyproject")
    args = parser.parse_args()
    if args.check:
        return check()
    if not args.version:
        parser.error("version required (or pass --check)")
    bump(args.version)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
